{
  "name": "studio-vaai-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "The studio vaai SDKs: the HTTP API contracts and the @studio-vaai/* packages",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "generate": "pnpm -r generate",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "tsgo -b",
    "lint": "oxlint --type-aware .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "publint": "pnpm -r --filter './sdks/*' exec publint"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "^0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "rollup-plugin-sbom": "5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12.18.0"
  },
  "packageManager": "pnpm@12.18.0"
}
