    "@studio-vaai/core": "workspace:*",
    "@studio-vaai/web-components": "workspace:*"
  },
  "devDependencies": {
    "vite": "^8.3.6",
    "vue": "3.0.0"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}
