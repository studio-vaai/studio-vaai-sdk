{
  "name": "@studio-vaai/vue",
  "version": "0.1.0",
  "description": "Vue integration for the studio vaai try-on experience",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
