{
  "name": "@studio-vaai/react-headless",
  "version": "0.3.1",
  "private": true,
  "description": "React hooks for the studio vaai virtual try-on flow (layer 2)",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && rm -f tsconfig.tsbuildinfo && tsgo --emitDeclarationOnly",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@studio-vaai/js-client": "workspace:*",
    "@studio-vaai/js-machine": "workspace:*",
    "@studio-vaai/js-tracking": "workspace:*",
    "@xstate/react": "^6.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "8.3.6",
    "xstate": "^5.33.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "xstate": "^5"
  }
}
