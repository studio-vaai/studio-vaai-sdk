{
  "name": "@studio-vaai/web-components",
  "version": "0.1.0",
  "description": "studio vaai virtual try-on UI as framework-free web components (Lit)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studio-vaai/studio-vaai-sdk.git",
    "directory": "sdks/web-components"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/define.js",
    "./src/define.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./define": {
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js"
    },
    "./experience": {
      "types": "./dist/experience/index.d.ts",
      "import": "./dist/experience/index.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && rm -f tsconfig.tsbuildinfo && tsgo --emitDeclarationOnly && cem analyze",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@studio-vaai/core": "workspace:*",
    "heic-to": "^1.6.7",
    "lit": "^3.3.3",
    "lit-html": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "jsdom": "^31.0.0",
    "vite": "8.3.6"
  },
  "customElements": "dist/custom-elements.json"
}
