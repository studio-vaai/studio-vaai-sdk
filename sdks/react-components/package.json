{
  "name": "@studio-vaai/react-components",
  "version": "0.3.1",
  "description": "Prebuilt studio vaai virtual try-on UI (layer 3)",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "import": "./dist/debug.js"
    },
    "./studio-vaai-components.css": "./dist/studio-vaai-components.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && node scripts/check-css-isolation.mjs && rm -f tsconfig.tsbuildinfo && tsgo --emitDeclarationOnly && node scripts/strip-css-from-dts.mjs",
    "check:css-isolation": "node scripts/check-css-isolation.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@studio-vaai/js-client": "workspace:*",
    "@studio-vaai/js-machine": "workspace:*",
    "@studio-vaai/react-headless": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "messageformat": "^4.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "postcss-prefix-selector": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup-preserve-directives": "^1.1.3",
    "tailwindcss": "^4.3.5",
    "vite": "8.3.6",
    "xstate": "^5.33.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
