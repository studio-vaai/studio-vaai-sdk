set shell := ["bash", "-euo", "pipefail", "-c"]

# The vendored crates, rustfmt, clippy and tests (the vendored crates' own
# among them), and the Flutter package's NOTICES and hook layout.
ci: mf2-check flutter-notices-check flutter-hooks-check
    cargo fmt --check
    cargo clippy --locked --workspace --all-targets --features studio-vaai-core/cli -- -D warnings
    cargo nextest run -P default --workspace --locked

# The Flutter package ships the core prebuilt, so its NOTICES carries the
# licenses of every crate the core links: rewrite it after a dependency change.
flutter-notices:
    python3 ../flutter/tool/notices.py

# Fail unless ../flutter/NOTICES matches Cargo.lock.
flutter-notices-check:
    python3 ../flutter/tool/notices.py --check

# Fail unless ../flutter/hook holds only the hook entry points: pub.dev refuses
# a package with any other file there ("Hook files are experimental"), so the
# hook's own code lives in ../flutter/lib/src/native.
flutter-hooks-check:
    #!/usr/bin/env bash
    set -euo pipefail
    extra=$(find ../flutter/hook -type f ! -path ../flutter/hook/build.dart ! -path ../flutter/hook/link.dart)
    if [[ -n $extra ]]; then
        echo "pub.dev accepts only hook/build.dart and hook/link.dart under hook/, not:" >&2
        echo "$extra" >&2
        exit 1
    fi

# rust-mf2, vendored in vendor/mf2: its crates.io packages, as pinned by
# patches/mf2/upstream.toml, changed only by the patches beside it. See
# patches/mf2/README.md.

# Rebuild vendor/mf2 from the pin and the patches.
mf2-vendor:
    patches/vendor.sh sync mf2

# Fail unless vendor/mf2 is exactly that rebuild.
mf2-check:
    patches/vendor.sh check mf2

# Record vendor/mf2's edits as the next patch, named in kebab-case.
mf2-patch name:
    patches/vendor.sh patch mf2 {{ name }}

# Fold vendor/mf2's edits into an existing patch, by number.
mf2-refresh number:
    patches/vendor.sh refresh mf2 {{ number }}

# uniffi-bindgen-react-native (ubrn) generates the web's TypeScript. Pinned to
# the head of jhugman/uniffi-bindgen-react-native#468, the unmerged UniFFI 0.32
# bump: released ubrn pins UniFFI 0.31, which lacks the zero-copy `&[u8]`
# argument. Move to a release once one supports 0.32.
ubrn_repo := "https://github.com/Dzejkop/uniffi-bindgen-react-native"
ubrn_rev := "06f0a30d257573ffcc852e84e814670d53085979"
ubrn := "build/ubrn/bin/uniffi-bindgen-react-native"

# The pinned ubrn: its CLI and its two TypeScript runtimes (@ubjs/core, the FFI
# converters; @ubjs/wasm, the player), built from source because the published
# packages predate UniFFI 0.32. Into build/ubrn and build/node_modules, once
# per pin.
ubrn:
    #!/usr/bin/env bash
    set -euo pipefail
    stamp=build/ubrn/rev
    [[ -x {{ ubrn }} && "$(cat $stamp 2>/dev/null)" == {{ ubrn_rev }} ]] && exit 0
    rm -rf build/ubrn build/node_modules/@ubjs
    git clone -q --filter=blob:none {{ ubrn_repo }} build/ubrn/src
    git -C build/ubrn/src checkout -q {{ ubrn_rev }}
    cargo install -q --locked --path build/ubrn/src/crates/ubrn_cli --root build/ubrn
    (cd build/ubrn/src/runtimes/wasm && npm ci -s --ignore-scripts --no-audit --no-fund)
    tsc=build/ubrn/src/runtimes/wasm/node_modules/.bin/tsc
    $tsc -p build/ubrn/src/typescript/tsconfig.esm.json
    $tsc -b build/ubrn/src/runtimes/wasm
    for package in core:typescript wasm:runtimes/wasm; do
      name=${package%%:*} source=build/ubrn/src/${package#*:}
      mkdir -p build/node_modules/@ubjs/$name
      cp -R $source/package.json $source/dist build/node_modules/@ubjs/$name/
    done
    echo {{ ubrn_rev }} > $stamp

# The web build, into build/wasm2: the crate as a WebAssembly module, beside the
# ubrn-generated TypeScript that runs it through the @ubjs/wasm player.
wasm: ubrn
    #!/usr/bin/env bash
    set -euo pipefail
    target_dir=$(cargo metadata --no-deps --format-version 1 | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')
    wasm="$target_dir/wasm32-unknown-unknown/release/studio_vaai_core.wasm"
    cargo build -q --release --lib -p studio-vaai-core --target wasm32-unknown-unknown
    rm -rf build/wasm2
    {{ ubrn }} generate wasm2 bindings --library "$wasm" --ts-dir build/wasm2 --no-format
    bash scripts/optimize-wasm.sh "$wasm" build/wasm2/studio_vaai_core.wasm

# Inventory the exact WASM artifact produced above. Requires cargo-cyclonedx 0.5.9.
wasm-sbom: wasm
    python3 ../build-tools/sbom/sbom.py native --target wasm32-unknown-unknown --artifact wasm32-unknown-unknown=build/wasm2/studio_vaai_core.wasm --output build/sbom

# uniffi-dart generates the Flutter SDK's Dart from the same annotations as the
# Swift, Kotlin and web bindings. Pinned to the head of Uniffi-Dart/uniffi-dart#149,
# the unmerged UniFFI 0.32 port (the released generator pins UniFFI 0.31), with
# the fixes in patches/uniffi-dart applied and its dependencies locked by the
# Cargo.lock there. See patches/uniffi-dart/README.md.
uniffi_dart_repo := "https://github.com/Uniffi-Dart/uniffi-dart"
uniffi_dart_rev := "a9029a4d2f2f90a86813ec005a36b744078604c0"
uniffi_dart := "build/uniffi-dart/bin/uniffi_bindgen_dart"

# The pinned, patched uniffi-dart CLI, into build/uniffi-dart, once per pin and
# set of patches.
uniffi-dart:
    #!/usr/bin/env bash
    set -euo pipefail
    stamp=build/uniffi-dart/stamp
    want="{{ uniffi_dart_rev }} $(cat patches/uniffi-dart/*.patch patches/uniffi-dart/Cargo.lock | shasum -a 256 | cut -d' ' -f1)"
    [[ -x {{ uniffi_dart }} && "$(cat $stamp 2>/dev/null)" == "$want" ]] && exit 0
    rm -rf build/uniffi-dart
    git init -q build/uniffi-dart/src
    git -C build/uniffi-dart/src fetch -q --depth 1 {{ uniffi_dart_repo }} {{ uniffi_dart_rev }}
    git -C build/uniffi-dart/src checkout -q FETCH_HEAD
    git -C build/uniffi-dart/src -c user.name=patches -c user.email=patches@localhost am -q "$PWD"/patches/uniffi-dart/*.patch
    cp patches/uniffi-dart/Cargo.lock build/uniffi-dart/src/Cargo.lock
    cargo install -q --locked --path build/uniffi-dart/src --features binary --root build/uniffi-dart
    echo "$want" > $stamp

# The Flutter SDK's generated Dart, into ../flutter/lib/src/generated: one file
# per UniFFI namespace (studio_vaai_core, api, state_machine) and the shared
# runtime, read from the host's build of the library. The Flutter package's
# build hook compiles the library for each app's target itself, or, installed
# from pub.dev, downloads the release's prebuilt one (../flutter/tool).
dart: uniffi-dart
    #!/usr/bin/env bash
    set -euo pipefail
    target_dir=$(cargo metadata --no-deps --format-version 1 | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')
    cargo build -q --lib -p studio-vaai-core
    library=$target_dir/debug/libstudio_vaai_core.dylib
    [[ -e $library ]] || library=$target_dir/debug/libstudio_vaai_core.so
    rm -rf ../flutter/lib/src/generated
    {{ uniffi_dart }} --library "$library" --out-dir ../flutter/lib/src/generated --no-format
    dart format -o write ../flutter/lib/src/generated >/dev/null
