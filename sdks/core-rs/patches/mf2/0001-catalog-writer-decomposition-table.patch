+#[cfg(test)]
+mod tests {
+    use alloc::string::String;
+    use alloc::vec::Vec;
+    use core::fmt::Write as _;
+
+    use unicode_normalization::char::decompose_canonical;
+
+    use super::DECOMPOSING;
+    use crate::nfc_map::{HANGUL_S_BASE, HANGUL_S_COUNT};
+
+    #[test]
+    fn the_list_is_every_code_point_that_decomposes() {
+        let mut ranges: Vec<(u32, u32)> = Vec::new();
+        let mut buf = Vec::new();
+        for cp in 0..=0x10_FFFF_u32 {
+            if cp.wrapping_sub(HANGUL_S_BASE) < HANGUL_S_COUNT {
+                continue;
+            }
+            let Some(ch) = char::from_u32(cp) else {
+                continue;
+            };
+            buf.clear();
+            decompose_canonical(ch, |c| buf.push(c));
+            if buf.as_slice() == [ch] {
+                continue;
+            }
+            match ranges.last_mut() {
+                Some((_, end)) if *end + 1 == cp => *end = cp,
+                _ => ranges.push((cp, cp)),
+            }
+        }
+        let mut list = String::new();
+        for (start, end) in &ranges {
+            let _ = writeln!(list, "    (0x{start:04X}, 0x{end:04X}),");
+        }
+        assert!(
+            ranges == DECOMPOSING,
+            "DECOMPOSING is out of date; the current list:\n{list}"
+        );
+    }
+}
diff --git a/mf2-catalog/src/writer/nfc_map.rs b/mf2-catalog/src/writer/nfc_map.rs
index 0ad757b..80b17de 100644
--- a/mf2-catalog/src/writer/nfc_map.rs
+++ b/mf2-catalog/src/writer/nfc_map.rs
@@ -24,10 +24,8 @@ use alloc::vec::Vec;
 use unicode_normalization::UnicodeNormalization;
 use unicode_normalization::char::{canonical_combining_class, decompose_canonical};
 
-use crate::nfc_map::{HANGUL_S_BASE, HANGUL_S_COUNT};
+use super::decomposing::DECOMPOSING;
 
-/// The highest code point.
-const MAX_CODE_POINT: u32 = 0x10_FFFF;
 /// Below this, a character is its own NFC form and cannot combine, which is
 /// the runtime's quick check (`nfc_quick`: every UTF-8 byte below 0xCC).
 const QUICK_LIMIT: u32 = 0x300;
@@ -48,14 +46,18 @@ where
 
     // Every code point whose full canonical decomposition stays inside the
     // set. Hangul syllables are left out: the reader decomposes them by
-    // arithmetic instead of carrying 11,172 entries.
+    // arithmetic instead of carrying 11,172 entries. The set's characters
+    // decompose to themselves (they came out of NFD forms); any other code
+    // point qualifies only through a decomposition that is not itself, and
+    // those are the `DECOMPOSING` ranges.
     let mut entries: BTreeMap<char, Vec<char>> = BTreeMap::new();
     let mut reaches_slow_path = false;
     let mut buf: Vec<char> = Vec::new();
-    for cp in 0..=MAX_CODE_POINT {
-        if cp.wrapping_sub(HANGUL_S_BASE) < HANGUL_S_COUNT {
-            continue;
-        }
+    let candidates = set
+        .iter()
+        .map(|&c| u32::from(c))
+        .chain(DECOMPOSING.iter().flat_map(|&(start, end)| start..=end));
+    for cp in candidates {
         let Some(ch) = char::from_u32(cp) else {
             continue;
         };
