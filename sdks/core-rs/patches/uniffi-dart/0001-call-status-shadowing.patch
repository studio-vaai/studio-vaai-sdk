         $interface_definition
 
         final _$finalizer_cls_name = Finalizer<Pointer<Void>>((ptr) {
-          rustCall((status) => $ffi_object_free_name(ptr, status));
+          rustCall((_uniffiStatus) => $ffi_object_free_name(ptr, _uniffiStatus));
         });
 
         class $cls_name $implements_clause {
@@ -302,7 +302,7 @@ pub fn generate_object(obj: &Object, type_helper: &dyn TypeHelperRenderer) -> da
                 if (_uniffiDisposed) {
                     throw StateError($(quoted(format!("Cannot use a disposed {cls_name}"))));
                 }
-                return rustCall((status) => $ffi_object_clone_name(_ptr, status));
+                return rustCall((_uniffiStatus) => $ffi_object_clone_name(_ptr, _uniffiStatus));
             }
 
             void dispose() {
@@ -311,15 +311,15 @@ pub fn generate_object(obj: &Object, type_helper: &dyn TypeHelperRenderer) -> da
                 }
                 // Reserve call-status storage before committing the closed
                 // state, so an allocation failure leaves disposal retryable.
-                final status = calloc<RustCallStatus>();
+                final _uniffiStatus = calloc<RustCallStatus>();
                 // Mark closed before calling Rust, including reentrant disposal.
                 _uniffiDisposed = true;
                 _$finalizer_cls_name.detach(this);
                 try {
-                    $ffi_object_free_name(_ptr, status);
-                    checkCallStatus(NullRustCallStatusErrorHandler(), status);
+                    $ffi_object_free_name(_ptr, _uniffiStatus);
+                    checkCallStatus(NullRustCallStatusErrorHandler(), _uniffiStatus);
                 } finally {
-                    calloc.free(status);
+                    calloc.free(_uniffiStatus);
                 }
             }
 
