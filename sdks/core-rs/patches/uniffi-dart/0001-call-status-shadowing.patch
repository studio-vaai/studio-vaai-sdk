From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: studio-vaai <info@studio-vaai.com>
Date: Wed, 18 Nov 2026 11:04:57 +0100
Subject: [PATCH 1/2] Name the call-status closure parameter so no argument
 shadows it

A function or method with an argument named `status` generated
`rustCallWithLifter((status) => f(lower(status), status), ...)`: the
closure's parameter shadowed the argument, so the call passed the
RustCallStatus pointer as the argument and failed to compile. The closure's
parameter is now `_uniffiStatus`, which no lowerCamelCase Rust name becomes.
(Upstream PR #178 fixes the same as part of a broader change.)
---
 src/gen/functions.rs |  8 +++---
 src/gen/objects.rs   | 64 ++++++++++++++++++++++----------------------
 2 files changed, 36 insertions(+), 36 deletions(-)

diff --git a/src/gen/functions.rs b/src/gen/functions.rs
index 56a0c52..eec5b92 100644
--- a/src/gen/functions.rs
+++ b/src/gen/functions.rs
@@ -72,15 +72,15 @@ pub fn generate_function(func: &Function, type_helper: &dyn TypeHelperRenderer)
         )
     } else {
         let call = if ret == quote!(void) {
-            quote!(rustCall((status) {
+            quote!(rustCall((_uniffiStatus) {
                 $(func.ffi_func().name())(
-                    $(for arg in &func.arguments() => $(DartCodeOracle::lower_arg_with_callback_handling(arg)),) status
+                    $(for arg in &func.arguments() => $(DartCodeOracle::lower_arg_with_callback_handling(arg)),) _uniffiStatus
                 );
             }, $error_handler))
         } else {
             quote!(rustCallWithLifter(
-                (status) => $(func.ffi_func().name())(
-                    $(for arg in &func.arguments() => $(DartCodeOracle::lower_arg_with_callback_handling(arg)),) status
+                (_uniffiStatus) => $(func.ffi_func().name())(
+                    $(for arg in &func.arguments() => $(DartCodeOracle::lower_arg_with_callback_handling(arg)),) _uniffiStatus
                 ),
                 $lifter,
                 $error_handler
