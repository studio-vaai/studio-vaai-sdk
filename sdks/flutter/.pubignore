# What pub leaves out of the published package. Pub reads this file in place of
# .gitignore here, so the generated bindings and lib/src/native/prebuilt.json,
# which git ignores, are published: the release workflow writes both before it
# packs.
.dart_tool/
build/
pubspec.lock
# Release tooling: it builds from the SDK repository's sources.
/tool/
# The widget goldens: the package's own visual regression tests, rendered on
# macOS; the other tests ship and run on the published package.
/test/goldens/
/test/goldens_test.dart
# Test data (the HEIC fixture): its tests skip without it.
/test/fixtures/
# The web's results the shared-vector test replays (written by the web SDK's
# tests): it skips without them.
/test/shared_vectors/
