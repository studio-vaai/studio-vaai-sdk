{
  "name": "@studio-vaai/js-machine",
  "version": "0.3.1",
  "private": true,
  "description": "State machines for the studio vaai virtual try-on flow",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build --config vite.lib.config.ts && rm -f tsconfig.tsbuildinfo && tsgo --emitDeclarationOnly",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run --config ../../vitest.config.ts",
    "test:watch": "vitest --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@studio-vaai/js-client": "workspace:*",
    "@studio-vaai/js-tracking": "workspace:*",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "vite": "8.3.6"
  }
}
