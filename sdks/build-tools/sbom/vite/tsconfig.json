{
  "compilerOptions": {
    "types": ["node"],
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noPropertyAccessFromIndexSignature": true,
    "composite": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ts"]
}
